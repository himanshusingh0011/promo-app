# Copy to .env and fill ONE block. Any OpenAI-compatible API works; swapping = these 3 lines.
# (Model names change often: check your provider's model list if one is rejected.)

# --- Cerebras (free tier, fastest) ---------------------------------------
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_BATCH=1
LLM_CONCURRENCY=4
LLM_RPM=25

# --- Google Gemini (free tier, no card; long context: 10 episodes per call = 5 calls per show) -
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-3.6-flash         # 2.5-flash is closed to new keys; list models at /v1beta/openai/models
# LLM_BATCH=10
# LLM_CONCURRENCY=2
# LLM_RPM=8
# LLM_MAX_TOKENS=6000
# LLM_TIMEOUT=300
# LLM_REASONING_EFFORT=low
# JUDGE_MODEL=gemini-3-flash-preview  # different model = separate quota + no self-grading

# --- Groq (free tier: fast tokens but ~8k tokens/min and ~200k tokens/day per model) ---
# One full show uses ~130k tokens incl. re-rank + judge, so it fits in one day's quota.
# These settings pace calls under the per-minute cap (429s are retried automatically).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_CONCURRENCY=1
# LLM_RPM=3
# LLM_MAX_TOKENS=2000
# Judge on a different Groq model = separate quota + not self-grading:
# JUDGE_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free models end in :free) --------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b:free
# LLM_BATCH=5

# --- Self-hosted GPU server (e.g. 32 GB) with Ollama ----------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# LLM_CONCURRENCY=4

# --- Optional: a DIFFERENT model for the cold-reader check (avoids self-grading)
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=

# --- Optional knobs
# LLM_REASONING_EFFORT=low      # sent to reasoning models; empty = provider default
# LLM_JSON_MODE=1               # set 0 if your server rejects response_format
# APP_PASSWORD=                 # web app: require this before using the server's key
